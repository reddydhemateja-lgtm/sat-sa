# SAT-SA backend configuration
# Copy this file to ".env" and adjust values as needed.
# In the terminal: copy .env.example .env

APP_NAME=SAT-SA
ENVIRONMENT=development

# Secret key used to sign JWT tokens. Change this in production.
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars-0123456789abcdef

# Access token lifetime in minutes (8 hours default)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database connection.
# Dev  : sqlite+aiosqlite:///./sat_sa.db
# Prod : postgresql+asyncpg://user:pass@host:5432/sat_sa
DATABASE_URL=sqlite+aiosqlite:///./sat_sa.db

# CORS origins (comma separated). Frontend dev server runs on port 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default admin account created by "python -m app.seed"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sat-sa.gov.in
ADMIN_PASSWORD=Admin@12345